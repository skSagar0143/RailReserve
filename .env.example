MYSQL_ROOT_PASSWORD=replace_with_random_local_root_password
MYSQL_USER=railreserve_app
MYSQL_PASSWORD=replace_with_random_local_app_password
REDIS_PASSWORD=replace_with_random_local_redis_password
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Generate RSA keys locally; never commit private keys.
RSA_PRIVATE_KEY_PATH=/run/secrets/railreserve-private.pem
RSA_PUBLIC_KEY_PATH=/run/secrets/railreserve-public.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Razorpay payment links. Keep all secrets server-side; use test credentials first.
PAYMENT_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=http://localhost:5173/payment-result
PAYMENT_CURRENCY=INR
