<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.railreserve</groupId>
    <artifactId>railreserve-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>coverage-report</artifactId>
  <packaging>pom</packaging>
  <name>RailReserve aggregate test coverage</name>
  <dependencies>
    <dependency><groupId>com.railreserve</groupId><artifactId>auth-service</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.railreserve</groupId><artifactId>train-service</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.railreserve</groupId><artifactId>booking-service</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.railreserve</groupId><artifactId>notification-service</artifactId><version>${project.version}</version></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
        <executions>
          <execution>
            <id>aggregate-report</id>
            <phase>verify</phase>
            <goals><goal>report-aggregate</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
